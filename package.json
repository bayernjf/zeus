{
  "name": "zeus",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./http": {
      "types": "./dist/http/server.d.ts",
      "default": "./dist/http/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "build:client": "tsc -p packages/zeus-client/tsconfig.json",
    "start": "node dist/http/serve.js",
    "daily": "node dist/daily/cli.js",
    "agent:example": "node dist/a2a/example-agent.js",
    "mcp:realm": "node dist/realm/mcp-stdio.js",
    "mcp-config": "node scripts/mcp-config.mjs",
    "vault": "node dist/vault/cli.js",
    "tui": "node dist/tui/cli.js",
    "verify:roster": "node scripts/verify-roster.mjs",
    "verify:decision-backend": "node scripts/verify-decision-backend.mjs",
    "verify:execute-delegation": "node scripts/verify-execute-delegation.mjs",
    "verify:intent-recognize": "node scripts/verify-intent-recognize.mjs",
    "verify:reliability": "node scripts/verify-runtime-reliability.mjs",
    "verify:personal-mcp": "node scripts/verify-personal-mcp.mjs",
    "acceptance:fanout": "node scripts/acceptance-real-fanout.mjs",
    "acceptance:loom": "node scripts/acceptance-loom-interop.mjs",
    "smoke:core": "node scripts/smoke-core.mjs",
    "e2e:m7": "node scripts/e2e-m7.mjs",
    "evals": "node scripts/eval-run.mjs",
    "watch:tick": "node scripts/run-watch-tick.mjs",
    "bench:capacity": "node scripts/bench-capacity.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:audit": "npm audit --omit=dev",
    "lint:secrets": "node scripts/scan-secrets.mjs",
    "verify:tui-recognize": "node scripts/verify-tui-recognize.mjs",
    "bench:gate": "node scripts/bench-gate.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^10.11.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "undici": "^6.29.0"
  }
}
