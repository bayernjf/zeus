# Zeus HTTP process configuration.
# Copy to .env and adjust; never commit real secrets (.env is gitignored).
#
# Nothing in the process reads this file: `docker run --env-file .env` and
# systemd EnvironmentFile= parse it for you, a bare `npm start` does not.
# On a host, export the vars yourself or start with
#   node --env-file=.env dist/http/serve.js      (Node 20.6+)

# Listen address. 127.0.0.1 = loopback only (bare metal); containers need 0.0.0.0.
ZEUS_HOST=127.0.0.1
ZEUS_PORT=8787

# Public base URL advertised on Zeus' inbound A2A agent card
# (GET /.well-known/agent-card.json). Set when a reverse proxy fronts the
# process; default is derived from the ZEUS_HOST/ZEUS_PORT bind defaults.
# ZEUS_PUBLIC_URL=https://zeus.example.com

# Bearer token for GET /api/roster (internal view).
# Leave unset to not mount the internal route at all (public roster still served).
ZEUS_INTERNAL_TOKEN=change-me-to-a-long-random-token

# Optional browser-origin allow-list for CORS headers, comma-separated (Web
# supervisor / any browser client). Emitted only for an exact Origin match -
# no wildcard reflection, no credentials. Unset/empty = no CORS headers, the
# API surface is unchanged for CLI/curl/TUI consumers.
# ZEUS_CORS_ORIGINS=http://127.0.0.1:5173,https://ops.example.com

# Per-process cap on concurrently attached LIVE SSE streams (GET
# /api/intents/:id/events waiting on new events). Replays of finished intents
# are served inline and do not occupy a slot. Past the cap the route answers
# 503 sse_unavailable. Unset = unbounded. Must be a positive integer.
# ZEUS_SSE_MAX_STREAMS=100

# How long a freshly attached live stream waits for the intent's first event
# when no backlog exists yet (the supported "open SSE, then POST fan-out"
# sequence). Past the grace the stream receives `event: error`
# (intent_unknown) and closes, so an unknown intent id cannot park a socket.
# Defaults to 30000 (30s). Must be a positive integer (milliseconds).
# ZEUS_SSE_ATTACH_GRACE_MS=30000

# Kernel state file (registry, oversight queue, intent idempotency tables).
# Unset = fully in-memory (everything is lost on restart). Directory must be writable.
ZEUS_STATE_FILE=./data/kernel-state.json

# E4.7: JSONL dispatch + governance audit log. When set, every audit entry is
# appended here (and still forwarded to stderr). Unset = nothing persisted; the
# bearer-protected GET /api/audit only mounts when this is configured.
# ZEUS_AUDIT_FILE=./data/audit.jsonl

# Decision API v1 (T-M1-06): signed JSONL decision audit trail (ADR-04, one
# sealed entry per decision/approval/policy event). When set, the file is
# opened 0600 and fully verified at boot; a tampered or gap chain refuses to
# open (fail-closed). Unset = the chain is in-memory and lost on restart.
# The trail is sealed with the RSK Ed25519 key, so pairing this with an
# ephemeral dev key means a restart can no longer verify the old chain and
# refuses to boot - configure ZEUS_RSK_KEY/FILE whenever the trail is set.
# ZEUS_DECISION_AUDIT_FILE=./data/decision-audit.jsonl

# Decision lifecycle webhook push: when ZEUS_DECISION_WEBHOOK_URL is set with a
# secret, the kernel POSTs decision created/late/approved/rejected/timed-out
# events to that URL (HMAC-SHA256 signed via x-zeus-signature, idempotency key
# x-zeus-delivery-id, bounded backoff). URL without secret is fail-closed
# (push disabled). Unset = no push, consumers poll listPending as before.
# ZEUS_DECISION_WEBHOOK_URL=https://ops-console.invalid/api/decision-events
# ZEUS_DECISION_WEBHOOK_SECRET=replace-with-long-random-secret

# T-M6-01 durable state: SQLite file holding decision policy/records/approvals
# and organizations/departments/positions/org_tasks. When set, the schema is
# migrated (idempotent) and state is hydrated on boot; a restart keeps every
# decision, approval, org and task. Unset = in-memory demo/test mode (lost on
# restart). The file must be on a persistent volume and excluded from images.
# ZEUS_DB_FILE=./data/zeus.db

# T-M7-02: agent-world channel adapter. When ZEUS_AGENT_WORLD_BASE_URL is set,
# the process assembles the first real OrgTaskExecutor + ToolInvoker + async
# TaskWorker: org tasks dispatch into agent-world graph runs (content ->
# tpl-xiaohongshu, listing -> tpl-review-publish, after-sales ->
# tpl-customer-service), with D2/D3 human checkpoints resumed through the
# decision ledger. Unset keeps the honest 503 ORG_EXECUTOR_UNCONFIGURED (no
# fake execution, no anonymous channel calls). Local offline verification runs
# agent-world itself with WORKER=fake.
# ZEUS_AGENT_WORLD_BASE_URL=http://127.0.0.1:3028

# Local secret backend: env-first with an optional secret file (env wins). The
# agent-world login lives behind the `agent-world:login` credential reference,
# resolved only for positions whose credential_refs grant it (least-privilege,
# fail-closed). The reference maps to ZEUS_SECRET_AGENT_WORLD_LOGIN by default.
# ZEUS_SECRET_FILE=./data/secrets.env
# ZEUS_SECRET_AGENT_WORLD_LOGIN={"email":"zeus@example.test","password":"change-me"}

# S6 V3: observability export files, both opt-in by path. Unset = the process
# behaves exactly as V1/V2: GET /api/metrics/history is not mounted, and no trace
# is written. When set, each settled intent appends its trace tree to
# ZEUS_TRACE_EXPORT_FILE (which also needs ZEUS_AUDIT_FILE - the tree is rebuilt
# from the audit spine), and one metrics snapshot is appended to
# ZEUS_METRICS_HISTORY_FILE on every state save. Both are local JSONL.
# ZEUS_TRACE_EXPORT_FILE=./data/trace-export.jsonl
# ZEUS_METRICS_HISTORY_FILE=./data/metrics-history.jsonl

# E4.11: A2A push callback receiver (design-a2a-push.md). When set, this process
# mounts POST /api/a2a/push-notifications (bearer = ZEUS_INTERNAL_TOKEN) and
# outbound intents are sent as plain tasks/send (not SSE), settling when the
# peer pushes the final task back, idempotent by taskId. Unset = endpoint not
# mounted, outbound intents stay on the streaming path (behavior unchanged).
# ZEUS_A2A_PUSH_URL=https://zeus.example.com/api/a2a/push-notifications

# deferred #42: decision-record retention. retain (default) keeps every settled
# intent in the state file; archive moves out-window intents (oldest-first,
# bounded by ZEUS_INTENT_RETENTION_MAX_ENTRIES / the 30-day window) to
# ./data/intent-archive.jsonl (append-only, idempotent replay keeps working);
# evict deletes them outright and documents idempotency as window-scoped.
# Only meaningful with ZEUS_STATE_FILE set; the archive lives beside it.
# ZEUS_INTENT_RETENTION=retain
# ZEUS_INTENT_RETENTION_MAX_ENTRIES=10000
# ZEUS_INTENT_RETENTION_WINDOW_MS=2592000000
# Ceiling for the ACTIVE audit file before it rotates (default 64MiB); rotated
# generations are kept as <file>.1 .. <file>.$ZEUS_AUDIT_KEEP (default 5).
# Total on-disk bound is maxBytes * (keep + 1). Set to 0/off/unlimited to opt
# out - an unbounded audit log will eventually fill the volume, so pair the
# opt-out with external logrotate. GET /api/audit reads the ACTIVE file's tail
# only; rotated generations are read with plain file tools.
# ZEUS_AUDIT_MAX_BYTES=67108864
# ZEUS_AUDIT_KEEP=5

# G1: comma-separated agent-card URLs auto-registered on boot (vassal seeds).
# URLs already restored from the state file are skipped. Each entry may carry an
# outbound credential as "<cardUrl>|<token>" (the pipe is not a legal URL
# character, so no escaping is needed).
# Runtime onboarding is the same thing over the bearer-protected internal API:
# POST /api/vassals accepts { cardUrl, taskUrl?, token? } and a stored token is
# never echoed back by that route or by any read view - dispatch is the only
# reader. An agent that needs a credential can therefore be added without a
# restart.
# ZEUS_VASSAL_SEEDS=https://pr-helper.example.com/api/a2a/agent-card,https://job-agent.example.com/.well-known/agent.json
ZEUS_VASSAL_SEEDS=

# A-12: explicit allowlist for the outbound URL guard, comma-separated.
# Every outbound face (agent-card fetch, A2A dispatch, MCP handshake/tool call)
# refuses a target that is not globally reachable - RFC1918, 169.254/16, CGNAT,
# multicast/reserved, and the IPv6 ULA / link-local / IPv4-encoded equivalents.
# Loopback (127.0.0.0/8, ::1) stays open because Zeus is local-first. Name a
# private host here to reach a peer on an internal network; a ".suffix" entry
# matches a whole domain suffix.
# ZEUS_OUTBOUND_ALLOW_HOSTS=10.0.0.5,.corp.internal

# G4: comma-separated personal realm roots connected on boot. Connected realms
# are written into the kernel state file and reconnected automatically after a
# restart, so this only needs to list roots on the first connect.
# ZEUS_REALM_ROOTS=/Users/me/Documents,/Users/me/Notes
ZEUS_REALM_ROOTS=

# E3.6: enterprise realm mounts, each as "<root>::<tenant>" where tenant is
# org[/department[/member]] (e.g. /srv/acme-eng::acme/eng). The double colon is
# deliberate - a Windows drive letter already owns the single one. An entry with
# no tenant, or an unusable one, aborts the boot: an enterprise realm mounted
# without its scope is a silently widened data domain. Reachability follows the
# hierarchy (an org subject may read down into its departments, never up or
# sideways); crossing INTO the enterprise domain from a personal-side subject
# needs a grant issued at runtime via POST /api/domains/grants.
# ZEUS_REALM_ENTERPRISE=/srv/acme::acme,/srv/acme-eng::acme/eng
ZEUS_REALM_ENTERPRISE=

# Roster Signing Key — Ed25519 PEM. Generate a keypair with:
#   node scripts/gen-rsk-key.mjs rsk-private.pem
# Either paste the PEM inline in ZEUS_RSK_KEY, or (preferred in containers /
# systemd) mount the file and set ZEUS_RSK_KEY_FILE to its path.
# ZEUS_RSK_KEY_FILE=./secrets/rsk-private.pem
# The public half is served unauthenticated at GET /api/roster/keys (kid + JWK +
# SPKI PEM + fingerprints). That channel is a convenience, not a trust anchor:
# verifiers must pin the published jwkThumbprint out of band. Rotating this key
# is a manual, announced action - runbook at docs/design-fealty-signing.md §5.4.
ZEUS_RSK_KEY=
ZEUS_RSK_KEY_ID=zeus-rsk-2026-09

# production  = refuse to boot without an RSK key (no ephemeral fallback);
# development = ephemeral in-memory key + stderr warning when no key is set.
NODE_ENV=development

# --- Decision backend (S2 arbitration + optional E1.3 adversarial judge) ---
# When no backend is fully configured the kernel boots rules-only (identical to
# before this section existed); arbitration and the judge simply stay off.
#
# Dedicated decision model (Jev). Preferred when both this and the LLM are set.
# Requires both URL and key; model is optional (provider default applies).
# ZEUS_DECISION_BASE_URL=https://decision.example.com/v1
# ZEUS_DECISION_API_KEY=replace-me
# ZEUS_DECISION_MODEL=jev-decision-1
ZEUS_DECISION_BASE_URL=
ZEUS_DECISION_API_KEY=

# Generic OpenAI-compatible LLM fallback was decommissioned in W7-3: the
# decision backend resolves exclusively through model-hub below. The legacy
# ZEUS_LLM_BASE_URL / ZEUS_LLM_API_KEY / ZEUS_LLM_MODEL vars are no longer read.

# model-hub (sole decision backend). When both URL and token are set, the
# decision primitives resolve models by alias (noul/choice/score) via
# model-kit; the issued credentials and unit prices are used and the catalog
# is cached on disk. With the hub unreachable or empty the process degrades
# to rules-only — there is no longer an env fallback.
# MODEL_HUB_URL=https://model-hub.internal
# MODEL_HUB_TOKEN=replace-with-project-token
# MODEL_HUB_CACHE_PATH=./data/model-cache.json
MODEL_HUB_URL=
MODEL_HUB_TOKEN=

# E1.3 adversarial LLM-as-judge. Opt-in (1/true/yes/on); requires a backend
# above, otherwise it stays off with a boot warning.
ZEUS_JUDGE_ENABLED=
# ZEUS_JUDGE_THRESHOLD=0.8
# ZEUS_JUDGE_ALLOW_UNCALIBRATED=

# design-evals W4-1: LLM-as-judge scorer for open-ended eval cases. Opt-in
# (1/true/yes/on); the model resolves through the hub wiring above by alias
# (default `choice`, override with ZEUS_EVAL_JUDGE_ALIAS). Every judge failure
# (alias unresolved, HTTP error, timeout, malformed output) is fail-soft: the
# eval check degrades to observe severity and never blocks the gate. Read by
# the eval runner (scripts/eval-run.mjs); the serve process never judges.
# ZEUS_EVAL_JUDGE_ENABLED=1
# ZEUS_EVAL_JUDGE_ALIAS=choice
# ZEUS_EVAL_JUDGE_TIMEOUT_MS=30000

# E1.5 branch concurrency. Unset = unbounded fan-out (every branch dispatches at
# once). The cap is process-wide across all intents, so it is what protects a
# shared downstream vassal. A malformed value aborts the boot rather than being
# silently ignored - a cap that is quietly dropped reads as protection that
# isn't there.
# ZEUS_MAX_CONCURRENT_BRANCHES=32
# Branches allowed to wait for a slot before one is refused (0 = never queue:
# overflow branches fail with a reason instead of waiting). Unset = unbounded wait.
# ZEUS_BRANCH_QUEUE_LIMIT=256
# E1.3/#9 per-vassal saturation line (>= 1). Setting it ENABLES backpressure
# diversion: during auto target selection, a vassal already at this many branches
# in flight is re-pointed to another provider of the same skill. It is NOT a
# per-vassal concurrency ceiling (that's ZEUS_MAX_CONCURRENT_BRANCHES' job), and it
# has to sit below that global cap or there is never an idle alternate to move to.
# Explicitly named request.vassals are hard-pinned and never diverted. Unset = no
# diversion. Non-numeric or < 1 aborts the boot.
# ZEUS_MAX_CONCURRENT_PER_VASSAL=4

# S9 cost gate (design-cost-governance §5): intent-level admission bound. The
# ledger refuses a fan-out that would cross the window cap or an open rate
# circuit (cost-budget-exceeded / cost-rate-circuit-open on the audit spine);
# self-reported cost never enters the gate. Unset = that dimension unlimited.
# Non-numeric or < 1 aborts the boot. Unit is a single token estimate; real
# pricing is deferred.
# ZEUS_COST_WINDOW_MS=60000
# ZEUS_COST_MAX_WINDOW_COST=1000
# ZEUS_COST_MAX_RATE_PER_WINDOW=500

# Terminal supervision deck (npm run tui) — a read/write CLIENT of the HTTP
# face, not a serve-time knob. These are read by dist/tui/cli.js only.
# Base URL of the Zeus bearer face; default http://127.0.0.1:8787.
# ZEUS_BASE_URL=http://127.0.0.1:8787
# Auto-refresh interval in ms (0 = manual refresh only); default 3000.
# ZEUS_TUI_INTERVAL_MS=3000

# Backup vault CLI (npm run vault) — driven by an external scheduler (cron /
# systemd timer), never read by the serve process. The passphrase below is read
# only when building or restoring encrypted bundles; keep it in the scheduler's
# environment, never in this file or the image. The name can be overridden with
# --passphrase-env; see docs/deployment.md §7 (cron example included).
# ZEUS_VAULT_PASSPHRASE=

# Memory embedding (MemoryPort contract v1 §4, ruling D-1). When enabled, fact
# embeddings are computed through the hub's `embed` alias assignment
# (doubao-embedding-vision) and every external call is audited by content hash
# only; hub unavailability degrades recall to the local hashing embedder for a
# cooldown window, then retries. Set to `off` to pin the local embedder and
# never leave the process boundary with memory text.
# ZEUS_MEMORY_EMBEDDING=on

# MemoryPort v1 §7 (ruling D-6): namespace-bound tokens for the cross-agent
# memory consumer face (POST /api/v1/memory/{recall,remember,forget},
# GET /api/v1/memory/counts). Format: "namespace:token,namespace2:token2".
# Each token binds to exactly one namespace (= realm id) and overrides any
# caller-claimed namespace, so a consumer cannot touch another realm's memory.
# Unset = the face is not mounted at all (fail-closed).
# ZEUS_MEMORY_SERVICE_TOKENS=job-agent:change-me-one,loom:change-me-two

# TracePort v1 §6 (W2-1): per-call decision ledger (JSONL, 0600). Every model
# call lands one line — tokens, cost in micros, latency — with free-text
# fields redacted and truncated per D-4. Unset = no ledger.
# ZEUS_DECISION_TRACE_FILE=./data/decision-traces.jsonl
